root = true

[*]
indent_style = space
indent_size = 4
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
end_of_line = lf

[*.{csproj,slnx,xml,config}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.cs]
max_line_length = off
csharp_prefer_braces = true:error
csharp_new_line_before_open_brace = none
csharp_new_line_before_else = false
csharp_new_line_before_catch = false
csharp_new_line_before_finally = false
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

# Expression-bodied members
csharp_style_expression_bodied_methods = true:error
csharp_style_expression_bodied_properties = true:error
csharp_style_expression_bodied_indexers = true:error
csharp_style_expression_bodied_accessors = true:error
csharp_style_expression_bodied_lambdas = true:error
csharp_style_expression_bodied_constructors = false:silent

# Null checking
csharp_style_throw_expression = true:error
csharp_style_pattern_matching_over_is_with_cast_check = true:error
csharp_style_pattern_matching_over_as_with_null_check = true:error
csharp_style_inlined_variable_declaration = true:error
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent

# Imports and modifiers
dotnet_style_qualification_for_field = false:silent
dotnet_style_qualification_for_property = false:silent
dotnet_style_qualification_for_method = false:silent
dotnet_style_qualification_for_event = false:silent
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error
dotnet_style_readonly_field = true:error

# Modern C# features
csharp_prefer_simple_default_expression = true:error
csharp_prefer_static_local_function = true:warning
csharp_prefer_index_operator = true:silent
csharp_prefer_range_operator = true:silent

# Suppressed analyzer rules
dotnet_diagnostic.CA1716.severity = none       # "Shared" in namespace (DotBahn.Data.Shared.* etc) — intentional naming
dotnet_diagnostic.CA1848.severity = none       # InMemoryCache.cs — LogDebug string interpolation, not perf-critical
dotnet_diagnostic.CA1816.severity = none       # no finalizers anywhere in codebase, SuppressFinalize unnecessary
dotnet_diagnostic.CA1305.severity = none       # string.ToString / string.Format without IFormatProvider — culture-invariant
dotnet_diagnostic.CA1307.severity = none       # string ops without StringComparison — culture-invariant by design
dotnet_diagnostic.CA1819.severity = none       # properties returning arrays in DTOs / contracts
dotnet_diagnostic.CA1859.severity = none       # interface-typed locals — DI polymorphism is intentional

# Samples
[samples/**/*.cs]
csharp_prefer_braces = false                   # IceMonitor/StationBrowser Program.cs — single-statement bodies
dotnet_diagnostic.CA2007.severity = none       # Program.cs — sample entry points, no sync context

[tests/**/*.cs]
csharp_prefer_braces = false                   # single-statement if/foreach in test methods
dotnet_diagnostic.CA1707.severity = none       # test method names: GetAsync_BuildsCorrectUrl_ReturnsXxx etc.
dotnet_diagnostic.CA1515.severity = none       # MockHttpHandler, ClientTestBase — must be public for xUnit
dotnet_diagnostic.CA2000.severity = none       # ClientTestBase, *ClientTests — HttpClient shared across test methods
dotnet_diagnostic.CA1063.severity = none       # ClientTestBase.Dispose() — test fixture, no subclass chain
dotnet_diagnostic.CA1002.severity = none       # MockHttpHandler.SentRequests — List<HttpRequestMessage> test property
dotnet_diagnostic.CA1054.severity = none       # ClientTestBase.AssertRequest(string relativeUrl) — test helper
dotnet_diagnostic.CA1822.severity = none       # CreateClient/CreateClientWithOptions() in test classes
dotnet_diagnostic.CA1852.severity = none       # TestClientBase nested class in ClientBaseTests, UriUtilTests
dotnet_diagnostic.CA1861.severity = none       # QueryParametersTests — constant array passed to Add()

# File-level
[**/ServiceCollectionExtension.cs]
dotnet_diagnostic.CA1034.severity = none       # C# 14 extension() creates nested public types

[**/AuthorizationHelper.cs]
dotnet_diagnostic.CA1034.severity = none       # extension(IServiceCollection) creates nested public types

[source/DotBahn.Clients/DotBahn.Clients.Shared/Client/ClientBase.cs]
dotnet_diagnostic.CA1054.severity = none       # GetAsync(string relativeUrl) — relative URL as string is intentional
dotnet_diagnostic.CA2000.severity = none       # Options constructor creates owned HttpClient, disposed in Dispose()

# Contracts
[**/Contracts/*Contract.cs]
dotnet_diagnostic.CA1002.severity = none       # StopDataContract.Messages, TimetableResponseContract.Stops etc.