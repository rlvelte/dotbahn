<Project>
  <!-- AOT compatibility analyzers (evaluated after the project file, so $(IsPackable) is known) -->
  <PropertyGroup>
    <IsAotCompatible Condition="'$(IsPackable)' == 'true'">true</IsAotCompatible>
    <IsTrimmable Condition="'$(IsPackable)' == 'true'">true</IsTrimmable>
    <EnableTrimAnalyzer Condition="'$(IsPackable)' == 'true'">true</EnableTrimAnalyzer>
  </PropertyGroup>
</Project>
