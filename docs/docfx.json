{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "source/DotBahn.Facilities/bin/Release/net10.0/DotBahn.Facilities.dll",
            "source/DotBahn.Stations/bin/Release/net10.0/DotBahn.Stations.dll",
            "source/DotBahn.Timetables/bin/Release/net10.0/DotBahn.Timetables.dll",
            "source/DotBahn.Common/bin/Release/net10.0/DotBahn.Common.dll",
            "source/DotBahn.Modules/DotBahn.Modules.Authorization/bin/Release/net10.0/DotBahn.Shared.dll",
            "source/DotBahn.Modules/DotBahn.Modules.Cache/bin/Release/net10.0/DotBahn.Shared.dll"
          ],
          "src": "..",
          "exclude": [
            "**/System.*.dll",
            "**/Microsoft.*.dll"
          ]
        }
      ],
      "dest": "api",
      "filter": "filterconfig.yml"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "api/**",
          "_site/**"
        ]
      },
      {
        "files": "api/*.yml",
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "globalMetadata": {
      "_appTitle": "DotBahn Documentation",
      "_appFooter": "MIT License — Robin L. Velte & Contributors",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_disableNavbar": false,
      "_disableBreadcrumb": false,
      "_gitLinkTemplate": "https://github.com/rlvelte/dotbahn/blob/master/{path}",
      "_appFaviconPath": "images/logo-16x16.png"
    },
    "dest": "_site",
    "template": [
      "default",
      "modern"
    ]
  }
}
