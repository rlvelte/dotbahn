{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "source/DotBahn.Clients/DotBahn.Clients.Facilities/bin/Release/net10.0/DotBahn.Clients.Facilities.dll",
            "source/DotBahn.Clients/DotBahn.Clients.Stations/bin/Release/net10.0/DotBahn.Clients.Stations.dll",
            "source/DotBahn.Clients/DotBahn.Clients.Timetables/bin/Release/net10.0/DotBahn.Clients.Timetables.dll"
          ],
          "src": "..",
          "exclude": [
            "**/System.*.dll",
            "**/Microsoft.*.dll",
            "**/DotBahn.Data.*.dll",
            "**/DotBahn.Modules.*.dll",
            "**/DotBahn.Clients.Shared.dll"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "api/**",
          "_site/**"
        ]
      },
      {
        "files": "api/*.yml",
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "globalMetadata": {
      "_appTitle": "DotBahn Documentation",
      "_appFooter": "MIT License — Robin L. Velte",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_disableNavbar": false,
      "_disableBreadcrumb": false,
      "_gitLinkTemplate": "https://github.com/rlvelte/dotbahn/blob/master/{path}",
      "_appLogoPath": "images/logo-48x48.png",
      "_appFaviconPath": "images/logo-16x16.png"
    },
    "dest": "_site",
    "template": [
      "default"
    ]
  }
}
