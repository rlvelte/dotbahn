{
  "stryker-config": {
    "test-runner": "mtp",
    "mutation-level": "Advanced",
    "coverage-analysis": "off",
    "additional-timeout": 30000,
    "reporters": ["html", "json", "markdown", "progress"],
    "ignore-mutations": ["block", "statement"],
    "ignore-methods": [
      "ConfigureAwait",
      "Dispose",
      "*ThrowIfNull",
      "*ThrowIfNullOrEmpty"
    ],
    "mutate": [
      "!**/*Options.cs",
      "!**/ServiceCollectionExtensions.cs"
    ],
    "thresholds": {
      "high": 90,
      "low": 80,
      "break": 0
    }
  }
}
