{
  "stryker-config": {
    "coverage-analysis": "off",
    "mutation-level": "Advanced",
    "additional-timeout": 30000,
    "reporters": ["html", "json", "progress"],
    "ignore-mutations": ["string"],
    "ignore-methods": [
      "*LogInformation",
      "*LogError",
      "*LogWarning",
      "*LogDebug",
      "*LogTrace",
      "*LogCritical"
    ],
    "mutate": [
      "!**/*Options.cs",
      "!**/ServiceCollectionExtensions.cs"
    ]
  }
}
